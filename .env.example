# OpenRouter API key.
# Auto-fetched + cached via: ./scripts/fetch_api_key.sh
# (idempotent; only re-fetches if .env missing or invalid)
OPENROUTER_API_KEY=

# Default models for benchmark runs (cheap for calibration, upgrade for primary)
OPENROUTER_CHEAP_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_PRIMARY_MODEL=anthropic/claude-haiku-4.5

# Cost budget cap (USD); aborts run when exceeded
LMA_BUDGET_USD=50.0
